# This project has no required environment variables of its own — see
# src/environments/*.ts for build-time configuration instead.
#
# A real .env.local here would typically be created by running
# `vercel link` + `vercel env pull .env.local` against this project's own
# (new, unlinked) Vercel project — never copy one from another project.
# It is gitignored (see .gitignore) and must never be committed.
#
# Build-time overrides the scripts/ toolchain reads, if you need them:
#   SITE_URL=https://example.com     # used by scripts/generate-sitemap.mjs
