# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diffed, never line-ending-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Generated — collapsed in diffs and excluded from language stats.
package-lock.json linguist-generated=true -diff
public/assets/i18n/*.json linguist-detectable=false
